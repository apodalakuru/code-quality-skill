{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/code-quality-fix/scripts/list_findings.py *)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/run_tests.py *)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/run_tests.py)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py start-session *)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py start-branch *)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py diff)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py discard)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py summary)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py finish *)",
      "Bash(python3 .claude/skills/code-quality-fix/scripts/git_fix.py end-session)"
    ]
  }
}
